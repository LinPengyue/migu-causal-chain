{
  "name": "production",
  "description": "chain4 业务骨架（annotation）：长链 + 其他三子类；默认 chain4_agent",
  "rules_mode": "annotation",
  "mapping": "params_first+annotation_compat",
  "classify": {
    "backend": "chain4_agent",
    "eval_filter": "none",
    "agent_margin": 0.12,
    "soft_other": true
  },
  "strip": {
    "backend": "agent",
    "agent_margin": 0.12,
    "min_margin": 0.08,
    "max_events": 12,
    "iou_dedupe": 0.5,
    "iou_recall": 0.45,
    "pre_ms": 120000,
    "post_ms": 60000,
    "window_ms": 180000,
    "step_ms": 90000
  },
  "extract": {
    "enabled": true,
    "use_gold_hint": false,
    "max_window": 12,
    "llm_refine": false
  },
  "llm": {
    "enabled": false,
    "ambiguous_margin": 0.12
  },
  "vlm": {
    "enabled": false,
    "max_frames": 3
  }
}
